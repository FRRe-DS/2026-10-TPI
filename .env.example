# ========================================================
# M8: Notificaciones, Documentos y Soporte - Variables de Entorno
# Copiar este archivo como .env para desarrollo local
# ========================================================

# Configuración del Servidor NestJS
PORT=3000
NODE_ENV=development
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:5173

# --------------------------------------------------------
# Base de Datos (PostgreSQL / Supabase)
# OPCIÓN A: Local Docker
POSTGRES_PORT=5432
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/m8_db?schema=public"
# OPCIÓN B: Supabase Cloud (Reemplazar con sus credenciales del proyecto Supabase)
# DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# --------------------------------------------------------
# Supabase Storage (Opcional - para almacenamiento cloud de PDFs)
SUPABASE_URL="https://[PROJECT_REF].supabase.co"
SUPABASE_ANON_KEY="tu-anon-key-de-supabase"
SUPABASE_SERVICE_ROLE_KEY="tu-service-role-key-de-supabase"
SUPABASE_STORAGE_BUCKET="receipts"

# --------------------------------------------------------
# Redis (Caché y TTL de Códigos QR - RF-8.3)
# Local Docker:
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# Cloud (ej. Upstash):
# REDIS_URL="rediss://default:[PASSWORD]@[HOST]:[PORT]"

# --------------------------------------------------------
# RabbitMQ (Broker de Mensajería Asíncrona - RF-8.8 / RNF-10)
# Local Docker:
RABBITMQ_URL="amqp://guest:guest@localhost:5672"
RABBITMQ_QUEUE="m8_notifications_queue"
RABBITMQ_EXCHANGE="urban_mobility_events"
RABBITMQ_EXCHANGE_TYPE=topic
RABBITMQ_DLX_EXCHANGE="notifications.dlx"
RABBITMQ_FAILED_QUEUE="notifications.failed"
RABBITMQ_FAILED_ROUTING_KEY="notifications.failed"
RABBITMQ_TRIP_COMPLETED_ROUTING_KEY=trip.completed

# --------------------------------------------------------
# Notificaciones / Servidor SMTP (Emails)
# Local Docker (Mailpit - visualización en http://localhost:8025):
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="soporte@movilidadurbana.local"

# --------------------------------------------------------
# Configuración del Dashboard Frontend (apps/frontend)
VITE_API_BASE_URL="http://localhost:3000/api/v1"

# --------------------------------------------------------
# Seguridad y Autenticación JWT / Keycloak (RNF-12 / M1)
# Configurar con los valores reales del Keycloak del Consorcio 2 al integrar con M1:
# AUTH_JWKS_URI="https://<KEYCLOAK_HOST>/realms/<REALM>/protocol/openid-connect/certs"
# AUTH_JWT_ISSUER="https://<KEYCLOAK_HOST>/realms/<REALM>"
# AUTH_JWT_AUDIENCE="<AUDIENCE_CONSORCIO>"
# Algoritmos asimétricos admitidos (nunca admite alg=none ni HS*):
AUTH_JWT_ALGORITHMS="RS256,RS384,RS512,ES256"
# Client IDs confiables para leer resource_access[clientId].roles (separados por coma):
AUTH_KEYCLOAK_CLIENT_IDS="m8-notificaciones,grupo-12,grupo-9"
AUTH_JWKS_CACHE_MAX_AGE_MS=600000
AUTH_JWKS_TIMEOUT_MS=5000
AUTH_JWT_CLOCK_TOLERANCE_SECONDS=5

# Proveedor local efímero de JWT RS256 SOLO para desarrollo local sin Keycloak
# (se bloquea estrictamente cuando NODE_ENV=production):
AUTH_DEV_TOKEN_PROVIDER_ENABLED=true
