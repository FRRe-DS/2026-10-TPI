# ========================================================
# M8: Notificaciones, Documentos y Soporte - Variables de Entorno
# Copiar este archivo como .env para desarrollo local
# ========================================================

# Configuración del Servidor NestJS
PORT=3000
NODE_ENV=development
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:5173

# --------------------------------------------------------
# Base de Datos (PostgreSQL / Supabase)
# OPCIÓN A: Local Docker
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/m8_db?schema=public"
# OPCIÓN B: Supabase Cloud (Reemplazar con sus credenciales del proyecto Supabase)
# DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# --------------------------------------------------------
# Supabase Storage (Opcional - para almacenamiento cloud de PDFs)
SUPABASE_URL="https://[PROJECT_REF].supabase.co"
SUPABASE_ANON_KEY="tu-anon-key-de-supabase"
SUPABASE_SERVICE_ROLE_KEY="tu-service-role-key-de-supabase"
SUPABASE_STORAGE_BUCKET="receipts"

# --------------------------------------------------------
# Redis (Caché y TTL de Códigos QR - RF-8.3)
# Local Docker:
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# Cloud (ej. Upstash):
# REDIS_URL="rediss://default:[PASSWORD]@[HOST]:[PORT]"

# --------------------------------------------------------
# RabbitMQ (Broker de Mensajería Asíncrona - RF-8.8 / RNF-10)
# Local Docker:
RABBITMQ_URL="amqp://guest:guest@localhost:5672"
RABBITMQ_QUEUE="m8_notifications_queue"
RABBITMQ_EXCHANGE="urban_mobility_events"

# --------------------------------------------------------
# Notificaciones / Servidor SMTP (Emails)
# Local Docker (Mailpit - visualización en http://localhost:8025):
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM="soporte@movilidadurbana.local"

# --------------------------------------------------------
# Configuración del Dashboard Frontend (apps/frontend)
VITE_API_BASE_URL="http://localhost:3000/api/v1"
